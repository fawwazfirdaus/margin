{
  "name": "margin-bookmarks",
  "version": "1.0.0",
  "description": "A local web app for reviewing and organizing X bookmarks.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.ts",
    "test": "node --test tests/*.test.js",
    "check": "npm run typecheck && node --check public/app.js && npm test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
