{
  "name": "margin-bookmarks",
  "version": "1.0.0",
  "description": "A local web app for reviewing and organizing X bookmarks.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.ts",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json --noEmit",
    "build": "tsc -p tsconfig.web.json",
    "prestart": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "tesseract.js": "7.0.0"
  }
}
